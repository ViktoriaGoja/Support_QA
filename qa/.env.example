# ─── QA service auth ────────────────────────────────────────────
# The QA web page signs staff in with Microsoft and sends their ID token.
# These are NOT secrets — they match clientId/tenant in the web page's
# src/authConfig.js.
MS_TENANT_ID=0812948c-d8a4-4cd0-914e-59942e064343
MS_CLIENT_ID=a575587c-9868-4fd7-8268-1556ac6308fb

# Optional key for scripts/manual testing (X-API-Key header). Never put it
# in the web page. Not the bot's BOT_API_KEY.
QA_API_KEY=choose-a-long-random-value

# ─── NICE CXone (Admin > Developer Portal > access keys) ────────
CXONE_ACCESS_KEY_ID=your-access-key-id
CXONE_ACCESS_KEY_SECRET=your-access-key-secret
CXONE_BASE_URL=https://api-na1.niceincontact.com
CXONE_TENANT_ID=your-tenant-id

PORT=5001
