# ─── QA service ─────────────────────────────────────────────────
# Its own key — NOT the bot's BOT_API_KEY. The QA web page sends this
# as the X-API-Key header. Required: without it every request is refused.
QA_API_KEY=choose-a-long-random-value

# ─── NICE CXone (Admin > Developer Portal > access keys) ────────
CXONE_ACCESS_KEY_ID=your-access-key-id
CXONE_ACCESS_KEY_SECRET=your-access-key-secret
CXONE_BASE_URL=https://api-na1.niceincontact.com
CXONE_TENANT_ID=your-tenant-id

PORT=5001
