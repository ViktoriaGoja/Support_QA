# ─── NICE CXone Authentication ───────────────────────────────────
# Get these from CXone Admin > Developer Portal
CXONE_ACCESS_KEY_ID=your-access-key-id
CXONE_ACCESS_KEY_SECRET=your-access-key-secret
CXONE_BASE_URL=https://api-na1.niceincontact.com
CXONE_TENANT_ID=your-tenant-id

# ─── Claude AI (Anthropic API) ──────────────────────────────────
# Sign up at console.anthropic.com to get an API key.
# When set, the bot uses Claude to answer questions.
# When blank, it falls back to keyword matching.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Bot Behaviour ──────────────────────────────────────────────
COMPANY_NAME=The Next Street
# The phrase Claude uses when it can't answer (triggers escalation)
ESCALATION_PHRASE=[ESCALATE]
# Message shown to the customer when escalating
FALLBACK_MESSAGE=I'm not sure I can help with that. Let me connect you with a team member.
# Confidence threshold for keyword mode (0-100). Ignored in Claude mode.
CONFIDENCE_THRESHOLD=45
# API key to protect your bot endpoints (set the same value in Studio scripts)
BOT_API_KEY=your-secret-api-key

# ─── Server ─────────────────────────────────────────────────────
PORT=5000
